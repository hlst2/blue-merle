#!/bin/sh

. /lib/blue-merle/functions.sh

if ! command -v gl_modem >/dev/null 2>&1; then
	echo "Error: the gl_modem helper is not available."
	echo "blue-merle requires GL.iNet's gl-sdk4 firmware (Mudi 7 / GL-E5800)."
	exit 1
fi

if ! gl_modem AT AT | grep -q OK; then
	echo "Error: the modem is not responding to AT commands."
	echo "Please reboot and contact the maintainer if the problem persists."
	exit 1
fi

# Mudi 7 has two SIM slots. Default to the active one but let the user pick.
current_slot=$(READ_SIM_SLOT)
echo "Currently active SIM slot: $current_slot"
echo -n "Operate on slot 1, slot 2, or current ($current_slot)? [1/2/c, default c]: "
read slot_choice
case "$slot_choice" in
	1) slot=1 ;;
	2) slot=2 ;;
	*) slot=$current_slot ;;
esac

if [ "$slot" != "$current_slot" ]; then
	echo "Switching to SIM slot $slot..."
	SET_SIM_SLOT "$slot"
	sleep 3
fi

echo -n "Swap SIM card in slot $slot and update IMEI? (Y/n): "
read answer
case $answer in
	n*) answer=0;;
	N*) answer=0;;
	*) answer=1;;
esac
if [[ "$answer" -eq 0 ]]; then
	exit 1;
fi


echo "Disabling the ME from both transmitting and receiving RF signals..."

old_imei=$(READ_IMEI "$slot")
old_imsi=$(READ_IMSI "$slot")

answer=1
while [[ "$answer" -eq 1 ]]; do
	gl_modem AT AT+CFUN=4 | grep -q OK
	if [[ $? -eq 1 ]]; then
		echo -n "...failed. Try again? (Y/n): "
		read answer
		case $answer in
			n*) answer=0;;
			N*) answer=0;;
			*) answer=1;;
		esac
		if [[ $answer -eq 0 ]]; then
			exit 1
		fi
	else
		answer=0
	fi
done

## We have just disabled the modem so it should not log on to any network.
## We set a random IMEI now only to have it overwritten very soon after
## the SIM card has been replaced. We intend to prevent an accidential
## leak of the new SIM's IMSI with the old IMEI just in case the modem
## accidentally tried to log in to the network.
python3 /lib/blue-merle/imei_generate.py -r --slot "$slot"


echo -n "Please now replace the SIM card in slot $slot and press any key to continue. "
read answer

leak=0

until gl_modem AT AT+CFUN=0 | grep -q OK
do
	sleep 1
	echo "CFUN=0 failed. Trying again."
done

until gl_modem AT AT+CFUN=4 | grep -q OK
do
	leak=1
	echo "CFUN=4 failed. Trying again."
done

if [[ $leak -eq 1 ]]; then
	echo
	echo "WARNING: Reset took longer than expected."
	echo
fi

sleep 1

new_imsi=$(READ_IMSI "$slot")

if [[ "$old_imsi" == "$new_imsi" ]]; then
	echo
	echo "WARNING: Old IMSI equals new IMSI."
	echo
fi

echo -n "Would you like to set a random (r) or deterministic (d) IMEI? (R/d): "
read answer
case $answer in
        d*) answer=0;;
        D*) answer=0;;
        *) answer=1;;
esac
if [[ "$answer" -eq 1 ]]; then
	python3 /lib/blue-merle/imei_generate.py -r --slot "$slot"
else
	python3 /lib/blue-merle/imei_generate.py -d --slot "$slot"
fi

new_imei=$(READ_IMEI "$slot")

if [[ "$old_imei" == "$new_imei" ]]; then
	echo
	echo "WARNING: Old IMEI equals new IMEI."
	echo
else
	mkdir -p /tmp/modem.1-1.2
	echo "$new_imei" > /tmp/modem.1-1.2/modem-imei
	# prevent imei leak via the LPA
	if [ -d /root/esim ]; then
		echo "$new_imei" > /root/esim/imei
		[ -f /root/esim/log.txt ] && shred -u /root/esim/log.txt
	fi
fi

echo "You should now reset the modem or shutdown the device."
echo "For extra privacy, you should shutdown the device and change your location."
echo
echo -n "Would you like to shutdown the device (s) or reset the modem (m)? (S/m): "
read answer
case $answer in
	m*) answer=0;;
	M*) answer=0;;
	*) answer=1;;
esac
if [[ "$answer" -eq 1 ]]; then
    echo '{ "msg": "Shutting down..." }' > /dev/ttyS0
    echo '{ "poweroff": "1" }' > /dev/ttyS0
else
	echo "Resetting modem..."
	# CFUN=1,1 issues a soft modem reset; AT+QPOWD is Quectel-only and
	# is not always available on the X72 firmware build.
	until gl_modem AT 'AT+CFUN=1,1' | grep -q OK
	do
		echo "Resetting modem failed. Trying again."
		sleep 1
	done

	time_start=$(date +%s)
	until imsi=$(gl_modem AT AT+CIMI | grep -w -E "[0-9]{6,15}")
	do
		time_now=$(date +%s)
		echo -ne "Waiting for reset to complete. ($(($time_now-$time_start))s/30s)\r"
		sleep 1
	done
	echo
	echo "FIN"
fi
